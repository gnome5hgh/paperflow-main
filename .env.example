# paperFlow 环境变量模板(提交进 git 的文档)
# 用法:复制为 .env 并填入你的真实值——`.env` 已被 .gitignore 忽略,不会进 git。
#   cp .env.example .env

# LLM API 密钥
# 留空时启动会报「LLM API key 未配置」——填上即可。
PAPERFLOW_API_KEY=sk-your-api-key
PAPERFLOW_BASE_URL=https://
PAPERFLOW_MODEL=MODEL_NAME

# Milvus 向量库地址（RAG 检索栈）。本机 Docker Standalone 用默认值即可；
# 改指远程实例则填 http://<host>:19530。
PAPERFLOW_MILVUS_URI=http://localhost:19530

# Obsidian vault 笔记/PDF/研究根目录(个人绝对路径,文件类工具的数据源)
PAPERFLOW_VAULT_NOTE_DIR=/path/to/note
PAPERFLOW_VAULT_PDF_DIR=/path/to/pdf
PAPERFLOW_VAULT_RESEARCH_DIR=/path/to/research

# GROBID 服务地址（PDF 解析 + 标题/书目提取）。本机 Docker 起 grobid 后默认即可
PAPERFLOW_GROBID_ENDPOINT=http://127.0.0.1:8070

# Semantic Scholar API key(可选)——配置后 web_search 的 semantic_scholar 源走高配额端点;留空用公共端点
PAPERFLOW_S2_API_KEY=

# 视觉模型（多模态图表分析）——默认 DeepSeek 视觉（与文本 LLM 同一端点/key）；
# 可改 BASE_URL/MODEL 换其他 OpenAI 兼容端点（如智谱 GLM-4V）；不配置则图表分析降级不可用
PAPERFLOW_VISION_BASE_URL=https://api.deepseek.com/v1
PAPERFLOW_VISION_API_KEY=sk-your-vision-key
PAPERFLOW_VISION_MODEL=deepseek-v4-flash-vision-exp
