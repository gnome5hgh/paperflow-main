# paperFlow 环境变量模板(提交进 git 的文档)
# 用法:复制为 .env 并填入你的真实值——`.env` 已被 .gitignore 忽略,不会进 git。
#   cp .env.example .env

# ── 必填 ──────────────────────────────────────────────────────────────────────
# LLM API 密钥(从 DeepSeek 平台获取:https://platform.deepseek.com)
# 留空时启动会报「LLM API key 未配置」——填上即可。
PAPERFLOW_API_KEY=sk-your-deepseek-api-key

# Obsidian vault 笔记/PDF 根目录(个人绝对路径,文件类工具的数据源;config.py 默认空)
PAPERFLOW_VAULT_NOTE_DIR=/path/to/obsidian/paper/note
PAPERFLOW_VAULT_PDF_DIR=/path/to/obsidian/paper/pdf

# ── 可选(有合理默认,需要覆盖才改) ─────────────────────────────────────────
# PAPERFLOW_BASE_URL=https://api.deepseek.com/v1
# PAPERFLOW_MODEL=deepseek-v4-flash
# PAPERFLOW_GROBID_ENDPOINT=http://localhost:8070
# PAPERFLOW_WORKSPACE=data
