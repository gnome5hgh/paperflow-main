# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Runtime data (except .gitkeep)
data/*
!data/.gitkeep
!data/intents/
!data/templates/

# Documentation (not version controlled)
docs/

# Claude Code Memory Bank — 静态资产进 git（settings.json/scripts/稳定文档），易变/个人文件保持忽略
# 注意：反选子文件必须用 .claude/* 排除内容而非 .claude/ 排除目录本身，否则 ! 规则对父目录被排除的子路径无效
.claude/*
!.claude/settings.json
!.claude/scripts/
!.claude/scripts/*
!.claude/SCOPE.md
!.claude/SYSTEM.md
!.claude/DECISIONS.md
!.claude/MEMORY_BANK.md

# 测试和脚本
/tests/
/scripts/

# 执行工作区（SDD 账本等临时产物）
.superpowers/

# ZCode 工作区（本地会话/配置，不入库）
.zcode/

# Environment
.env
.env.local
config.yaml

# 路由语料向量缓存（运行时产物）
# 注：gitignore 模式不支持行尾内联注释（`#` 后的内容会并入模式导致失配），故注释独立成行
data/intents/routes_vectors.npz
