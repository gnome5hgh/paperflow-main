# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Runtime data (except .gitkeep)
data/*
!data/.gitkeep
!data/intents/
!data/templates/

# Documentation (not version controlled)
docs/

# Claude Code Memory Bank — 静态资产进 git（settings.json/scripts/稳定文档），易变/个人文件保持忽略
# 注意：反选子文件必须用 .claude/* 排除内容而非 .claude/ 排除目录本身，否则 ! 规则对父目录被排除的子路径无效
.claude/*
!.claude/settings.json
!.claude/scripts/
!.claude/scripts/*
!.claude/SCOPE.md
!.claude/SYSTEM.md
!.claude/DECISIONS.md
!.claude/MEMORY_BANK.md

# 测试和脚本
./tests
./scripts

# Environment
.env
.env.local
config.yaml
